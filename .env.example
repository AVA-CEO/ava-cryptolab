# Copy the web setting into apps/web/.env.local.
API_BASE_URL=http://127.0.0.1:8000
# Copy backend settings into services/api/.env (run API commands there).
DATABASE_URL=sqlite:///./ava.db
# Production alternative: postgresql+psycopg://user:password@host:5432/ava
APP_ENV=local
UPLOAD_DIR=./uploads
# Disabled on the normal journal. The disposable practice runner enables this.
ACCOUNT_MANAGEMENT_ENABLED=false
